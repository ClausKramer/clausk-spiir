{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalName": { "value": "${AZURE_PRINCIPAL_NAME}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE=User}" },
    "jwtSigningKey": { "value": "${JWT_SIGNING_KEY}" },
    "goCardlessSecretId": { "value": "${GOCARDLESS_SECRET_ID=not-configured}" },
    "goCardlessSecretKey": { "value": "${GOCARDLESS_SECRET_KEY=not-configured}" },
    "anthropicApiKey": { "value": "${ANTHROPIC_API_KEY=not-configured}" }
  }
}
